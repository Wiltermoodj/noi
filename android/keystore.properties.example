# Copy to android/keystore.properties (never commit the real file or .jks keystore)
# Generate an upload keystore with:
# keytool -genkey -v -keystore noi-upload-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias noi-upload

storeFile=/absolute/path/to/noi-upload-key.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=noi-upload
keyPassword=YOUR_KEY_PASSWORD
